{
  "name": "agentguard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Diff-first GitHub App orchestrator for multi-agent repositories.",
  "scripts": {
    "dev": "tsx watch backend/src/index.ts",
    "dev:dashboard": "next dev dashboard",
    "sandbox:build": "docker build -t agentguard-sandbox sandbox",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/backend/src/index.js",
    "build:dashboard": "next build dashboard",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@octokit/auth-app": "^8.1.0",
    "@octokit/rest": "^22.0.0",
    "bullmq": "^5.58.0",
    "dotenv": "^16.6.0",
    "express": "^5.1.0",
    "ioredis": "^5.6.1",
    "next": "^15.3.0",
    "probot": "^14.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
